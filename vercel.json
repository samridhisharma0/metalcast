{
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "type": "static",
        "path": "frontend/dist/assets/$1"
      }
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": {
        "type": "static",
        "path": "frontend/dist/index.html"
      }
    }
  ]
}

# =======================================================================
# MetalCast backend configuration
# =======================================================================
# Copy this file to backend/.env and fill in the values below.

# ----------------- Database -----------------
# Any of the following formats works:
#   postgres://user:pass@host:5432/dbname
#   postgresql://user:pass@host:5432/dbname
#   postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql://metalcast:metalcast@localhost:5432/metalcast

# ----------------- Server -----------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Allow-list for the CORS layer. Comma-separated. * disables CORS entirely.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Required for /api/admin/* routes. Pick something long and random.
ADMIN_TOKEN=my-secret-token-123

# ----------------- Price providers -----------------
# All keys are OPTIONAL. If none of the keyed providers are set, the backend
# falls back to Yahoo Finance futures (ALI=F, HG=F) which is real market data
# but delayed and futures-based. That fallback is labelled in the UI.
#
# metals.dev  -- https://metals.dev/
METALS_DEV_API_KEY=
# metalpriceapi.com -- https://metalpriceapi.com/
METALPRICE_API_KEY=
# commodities-api.com -- https://commodities-api.com/
COMMODITIES_API_KEY=

# Set to true ONLY for offline development. Synthetic data is clearly marked
# in the UI. Do NOT enable this for the graded deliverable.
ALLOW_SYNTHETIC=false

# ----------------- News providers -----------------
# Every key is OPTIONAL. RSS feeds work without a key.
NEWSAPI_KEY=
GNEWS_API_KEY=
MARKETAUX_API_KEY=

# ----------------- Scheduler intervals (seconds) -----------------
PRICE_POLL_INTERVAL_SECONDS=90
NEWS_POLL_INTERVAL_SECONDS=1200
FORECAST_INTERVAL_SECONDS=3600
ACCURACY_INTERVAL_SECONDS=10800

# ----------------- Forecast tuning -----------------
BACKFILL_DAYS_ON_BOOT=900
MIN_HISTORY_POINTS=90
BACKTEST_ORIGINS=30
MODEL_VERSION=ensemble-v1.3
SHORT_HORIZONS=1..7
LONG_HORIZONS=21,42,63,84,105,126

# ----------------- Rate limiting -----------------
RATE_LIMIT_PER_MINUTE=240
